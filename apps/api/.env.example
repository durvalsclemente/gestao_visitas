# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Banco ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestao_visitas?schema=public

# --- JWT da Central de Acessos ---
# Algoritmo aceito: RS256 (recomendado, com chave pública) ou HS256 (segredo compartilhado).
CENTRAL_JWT_ALG=RS256
# Para RS256, cole a chave pública PEM (com \n literais ou multilinhas via aspas no .env real):
CENTRAL_JWT_PUBLIC_KEY=
# Para HS256, defina o segredo compartilhado (ignorado se usar RS256):
CENTRAL_JWT_SECRET=
CENTRAL_JWT_ISSUER=central-acessos
CENTRAL_JWT_AUDIENCE=gestao-visitas

# --- Webhooks da Central ---
# Tipos suportados: API_KEY | BEARER | BASIC
CENTRAL_WEBHOOK_AUTH_TYPE=API_KEY
CENTRAL_WEBHOOK_AUTH_HEADER=X-Central-Signature
CENTRAL_WEBHOOK_AUTH_VALUE=changeme

# --- URL pública da Central (fallback de redirect quando JWT inválido) ---
CENTRAL_URL=https://central.exemplo.com

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
